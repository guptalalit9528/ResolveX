# ResolveX Environment Configuration Example

# Server Environment
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
WEB_APP_URL=http://localhost:5173

# Database Connections (Dual Role Security Model)
# Application runtime role (SELECT, INSERT, UPDATE, DELETE on data; strictly INSERT/SELECT on audit)
DATABASE_URL=postgresql://resolvex_app:app_secure_pass@localhost:5432/resolvex_db
# Migration owner role (Full schema creation/alteration privileges)
DATABASE_OWNER_URL=postgresql://resolvex_owner:owner_secure_pass@localhost:5432/resolvex_db

# Security & Sessions
SESSION_SECRET=dev-session-key-must-be-at-least-32-chars-long-abc12345
CSRF_SECRET=dev-csrf-key-must-be-at-least-32-chars-long-xyz98765
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Storage Service (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resolvex-media
S3_FORCE_PATH_STYLE=true

# Email Service (Mailpit in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_NAME="ResolveX Notifications"
SMTP_FROM_EMAIL=no-reply@resolvex.college.edu

# Default Tenant Configuration
DEFAULT_ORG_SLUG=campusfix-college
DEFAULT_TIMEZONE=Asia/Kolkata
