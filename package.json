{
  "name": "resolvex-root",
  "version": "1.0.0",
  "private": true,
  "description": "ResolveX - Multi-Organization Responsive Problem Resolution Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:worker": "npm run start:dev --workspace=apps/worker"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2"
  }
}
